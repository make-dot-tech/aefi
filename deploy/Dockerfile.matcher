# Matcher worker (Cloud Run) — health on PORT + poll loop
# docker build -f deploy/Dockerfile.matcher -t aefi-matcher .

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY services/matcher/package.json ./services/matcher/
RUN pnpm install --frozen-lockfile --filter @aefi/matcher...

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 matcher

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/matcher/node_modules ./services/matcher/node_modules

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY services/matcher ./services/matcher

USER matcher
WORKDIR /app/services/matcher
EXPOSE 8080
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
