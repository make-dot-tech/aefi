# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# Optional: first-run start block (default = chain tip)
# INDEXER_START_BLOCK=55960000
# INDEXER_ABI_DIR=services/indexer/abi/5042002

# Postgres (docker-compose defaults)
DATABASE_URL=postgres://aefi:aefi@localhost:5432/aefi?sslmode=disable

# Neo4j (optional; docker compose --profile graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aefi-dev-password

# API
AEFI_HTTP_PORT=8787
AEFI_API_KEY=dev-local-key
AEFI_RESOURCE_BASE_URL=http://localhost:8787

# Disposition rules (Drools) — fallback to local TS composer if down
AEFI_RULES_URL=http://localhost:8090
AEFI_RULES_ENABLED=true

# x402 agent paywall (#6)
AEFI_X402_ENABLED=false
AEFI_X402_PAY_TO=0x000000000000000000000000000000000000aef1
AEFI_X402_PRICE_USDC=0.01
# AEFI_X402_PRICE_ATOMIC=10000
AEFI_X402_NETWORK=eip155:5042002
AEFI_X402_ASSET=0x3600000000000000000000000000000000000000
# Optional facilitator verify endpoint (POST /verify)
# AEFI_X402_FACILITATOR_URL=https://facilitator.example.com
# Local/dev: accept structurally valid PAYMENT-SIGNATURE without facilitator
AEFI_X402_DEV_ACCEPT=true
