{
  "name": "@aefi/matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "project:once": "tsx src/index.ts --once"
  },
  "dependencies": {
    "neo4j-driver": "^6.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
