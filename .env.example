# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# Optional: first-run start block (default = chain tip)
# INDEXER_START_BLOCK=55960000
# INDEXER_ABI_DIR=services/indexer/abi/5042002
# INDEXER_POLL_MS=5000
# INDEXER_BATCH_SIZE=10

# Postgres (docker-compose defaults)
DATABASE_URL=postgres://aefi:aefi@localhost:5432/aefi?sslmode=disable

# Neo4j (optional; docker compose --profile graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aefi-dev-password

# API
AEFI_HTTP_PORT=8787
AEFI_API_KEY=dev-local-key
AEFI_RESOURCE_BASE_URL=http://localhost:8787
# Comma-separated extra CORS origins (studio/www defaults are built-in)
# AEFI_CORS_ORIGINS=https://preview.example.com

# Disposition rules (Drools) — falls back to local TS composer if down.
# For demo without services/rules, set false to skip the :8090 fetch entirely.
AEFI_RULES_URL=http://localhost:8090
AEFI_RULES_ENABLED=false

# x402 agent paywall (Circle Gateway nanopayments)
# Off locally by default. Production payTo is public (402 accepts[]).
AEFI_X402_ENABLED=false
AEFI_X402_PAY_TO=0xaEF1f897140C9a01a291d9e09865B519c997691B
AEFI_X402_PRICE_USDC=0.01
# Optional: restrict CAIP-2 networks (default = all Circle Gateway chains)
# AEFI_X402_NETWORKS=eip155:8453,eip155:5042,eip155:1
# Omit to use Circle Gateway mainnet (https://gateway-api.circle.com)
# AEFI_X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com
