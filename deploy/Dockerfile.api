# Hono API (Cloud Run) — TypeScript via tsx
# Use Debian (not Alpine): @xenova/transformers → onnxruntime-node needs glibc.
# docker build -f deploy/Dockerfile.api -t aefi-api .

FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY services/api/package.json ./services/api/
RUN pnpm install --frozen-lockfile --filter @aefi/api...

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787
ENV TRANSFORMERS_CACHE=/tmp/transformers
ENV HF_HOME=/tmp/transformers
ENV COREPACK_HOME=/tmp/corepack
ENV HOME=/tmp

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs --home-dir /tmp apiuser \
  && mkdir -p /tmp/transformers /tmp/corepack \
  && chown -R apiuser:nodejs /tmp

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/api/node_modules ./services/api/node_modules

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY services/api ./services/api

USER apiuser
WORKDIR /app/services/api
EXPOSE 8787
# Avoid corepack re-download at runtime; call local tsx directly.
CMD ["node", "--import", "tsx", "src/index.ts"]
